{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", "src/components/pages/FindSchoolDetailPage.jsx", "src/components/organism/DetailCard.jsx", "src/components/pages/FindCollegeDetailsPage.jsx", "src/components/pages/FindCollegePage.jsx", "src/components/pages/FindCouchingPage.jsx", "src/components/pages/FindInstituteDetailPage.jsx", "src/components/pages/FindPage.jsx", "src/components/pages/FindSchoolPage.jsx", "src/features/api/collegeApiSlice.js", "src/features/api/schoolApiSlice.js", "src/components/organism/CollegeDetailedComponents/CollegeFeesBreakUp.jsx", "src/app/(public)/(admin-dashboard)/layout.js"],
  "exclude": ["node_modules"]
}
